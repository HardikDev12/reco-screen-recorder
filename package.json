{
  "name": "reco-screen-recorder",
  "version": "1.0.0",
  "description": "Simple, high-quality Windows screen recorder inspired by ShowMore",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "clean": "powershell -Command \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue dist, dist-electron, release\"",
    "dev": "vite",
    "build": "npm run clean && tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:electron": "tsc -p tsconfig.node.json && vite build",
    "pack": "cross-env CSC_IDENTITY_AUTO=0 electron-builder --dir --publish never && node scripts/patch-icon.js",
    "dist": "cross-env CSC_IDENTITY_AUTO=0 electron-builder --publish never && node scripts/patch-icon.js",
    "dist:portable": "cross-env CSC_IDENTITY_AUTO=0 electron-builder --win portable --publish never"
  },
  "keywords": [
    "reco",
    "screen-recorder",
    "electron",
    "ffmpeg",
    "showmore",
    "offline-recording",
    "windows"
  ],
  "author": "Hardik Prajapati",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.16.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "overrides": {
    "tar": "^7.5.3"
  }
}
