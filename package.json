{
  "name": "reco",
  "version": "1.0.0",
  "description": "Simple, high-quality Windows screen recorder inspired by ShowMore",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:electron": "tsc -p tsconfig.node.json && vite build",
    "pack": "cross-env CSC_IDENTITY_AUTO=0 electron-builder --dir && node scripts/patch-icon.js",
    "dist": "cross-env CSC_IDENTITY_AUTO=0 electron-builder && node scripts/patch-icon.js",
    "dist:portable": "cross-env CSC_IDENTITY_AUTO=0 electron-builder --win portable"
  },
  "keywords": [
    "reco",
    "screen-recorder",
    "electron",
    "ffmpeg",
    "showmore",
    "offline-recording",
    "windows"
  ],
  "author": "Hardik Prajapati",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
